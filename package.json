{
  "name": "ci-local-guard",
  "version": "0.2.0",
  "description": "AI-first exact-commit CI preflight and evidence-based CI diagnostics",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "ci-local-guard": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src/",
    "hooks/",
    "README.md",
    "README.zh-TW.md",
    "assets/banner/banner.webp",
    "docs/reference.md",
    "docs/reference.zh-TW.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-TW.md"
  ],
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "distribution:check": "node quality/distribution.mjs",
    "distribution:sync": "node quality/distribution.mjs --write"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cablate/ci-local-guard.git"
  },
  "bugs": {
    "url": "https://github.com/cablate/ci-local-guard/issues"
  }
}
